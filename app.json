{
  "expo": {
    "name": "Gadget Brust",
    "slug": "gadget-brust-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gadgetbrust.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F7F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gadgetbrust.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Gadget Brust",
      "shortName": "Gadget Brust",
      "description": "Genuine gadgets with official warranty, fast delivery across Bangladesh.",
      "themeColor": "#38ad81",
      "backgroundColor": "#eef0eb"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "scheme": "gadgetbrust"
  }
}
