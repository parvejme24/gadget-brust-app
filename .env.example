# Copy to .env.local.
# Live API (also the default when this is not set):
EXPO_PUBLIC_API_URL=https://gadgetbrust-server.vercel.app/api

# Local API: run `npm run dev` in gadget-brust-server. On a real phone use your computer's LAN IP, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.0.107:6060/api
