# Copy to .env.local. On a real phone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.107:6060/api

# Production web build (Vercel): set EXPO_PUBLIC_API_URL in the Vercel project's
# Environment Variables to your deployed HTTPS API, e.g. https://api.yourdomain.com/api
